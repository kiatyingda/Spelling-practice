// Copy to Config/Secrets.xcconfig (gitignored) and fill in. Re-run `xcodegen` after changing.

// Your Apple ID team: Xcode → Settings → Accounts → (team) → Team ID. Free accounts work.
DEVELOPMENT_TEAM = ABCDE12345

// Must match APP_TOKEN in the Vercel project's environment variables.
APP_TOKEN = change-me

// xcconfig treats `//` as a comment, so split the scheme with $().
API_BASE_URL = https:/$()/your-project.vercel.app
